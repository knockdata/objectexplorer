<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- a Quick Look extension is only registered when it is sandboxed; Quick Look hands it read
	     access to the one file it asks about. allow-jit lets JavaScriptCore compile the preview
	     bundle under the hardened runtime instead of interpreting it. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
